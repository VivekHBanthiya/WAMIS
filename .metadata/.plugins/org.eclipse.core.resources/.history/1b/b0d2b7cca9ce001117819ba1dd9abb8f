package cdac.egov.qmssvr.controllers;

import java.util.List;

import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import cdac.egov.WMS.entities.Unit;
import cdac.egov.WMS.repositories.UnitRepository;

@RestController
@RequestMapping("/api/units")
@CrossOrigin(origins = "http://localhost:4200")
public class UnitController {

    private final UnitRepository repository;

    public UnitController(UnitRepository repository) {
        this.repository = repository;
    }

    @GetMapping
    public List<Unit> getUnits() {
        return repository.findByActiveTrueOrderByShortNameAsc();
    }
}